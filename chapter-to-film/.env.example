# --- Required ---------------------------------------------------------------
# Claude reads the chapter and writes the storyboard. console.anthropic.com
ANTHROPIC_API_KEY=

# --- Voice (narration) --------------------------------------------------------
# Any ElevenLabs-compatible text-to-speech service. Point VOICE_BASE_URL at your
# Murdoch Studio Voice Studio once its address is known; leave it empty to use
# ElevenLabs itself. Without a key, the film renders with silent timing.
VOICE_API_KEY=
VOICE_BASE_URL=https://api.elevenlabs.io
VOICE_ID=
VOICE_MODEL=eleven_multilingual_v2

# --- Images and video clips (fal.ai: one key for many models) ---------------
# Without a key, illustrated scenes use a plain title card instead.
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/dev
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/text-to-video
# AI video is the expensive part. This caps clips per film.
MAX_VIDEO_CLIPS=3

# --- Optional -----------------------------------------------------------------
# Language of the narration (the chapter's own language if empty).
FILM_LANGUAGE=
# Chrome/Chromium for rendering. Leave empty and Remotion downloads its own.
CHROME_PATH=
